{
  "name": "Feature branches — single-line Conventional Commits",
  "target": "branch",
  "source_type": "Repository",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": ["refs/heads/main", "refs/heads/master", "refs/heads/dependabot/*"],
      "include": ["refs/heads/*"]
    }
  },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "operator": "matches",
        "pattern": "\\A(feat|fix|docs|test|chore|refactor|perf|ci|build|revert)(\\([a-z0-9._-]+\\))?: [^\\n]+\\z"
      }
    }
  ]
}
