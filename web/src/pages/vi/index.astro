---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DesktopSimulator from '../../components/DesktopSimulator.astro';
import MetricsProof from '../../components/MetricsProof.astro';
import BentoGrid from '../../components/BentoGrid.astro';
import ShortcutMatrix from '../../components/ShortcutMatrix.astro';
import DistributionHub from '../../components/DistributionHub.astro';
import BackToTop from '../../components/BackToTop.astro';
import { getI18n } from '../../i18n';

const lang = 'vi';
const t = getI18n(lang);
---

<BaseLayout
  lang={lang}
  title={t.site.title}
  description={t.site.description}
  keywords={t.site.keywords}
>
  <Header lang={lang} />

  <main class="main-content">
    <!-- Hero Section Baseline -->
    <section class="hero-section page-container">
      <div class="hero-badge-wrapper">
        <div class="version-badge">
          <span>{t.hero.badge}</span>
          <span class="badge-separator">•</span>
          <span>{t.hero.version}</span>
        </div>
      </div>

      <h1 class="hero-title">
        {t.hero.titleLine1} <br />
        <span class="hero-highlight">{t.hero.titleHighlight}</span>
      </h1>

      <p class="hero-subtitle">
        {t.hero.subtitle}
      </p>

      <div class="hero-actions">
        <a href="#download" class="action-pill">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
            <path d="M10.75 2.75a.75.75 0 00-1.5 0v8.614L6.295 8.235a.75.75 0 10-1.09 1.03l4.25 4.5a.75.75 0 001.09 0l4.25-4.5a.75.75 0 00-1.09-1.03l-2.955 3.129V2.75z" />
            <path d="M3.5 12.75a.75.75 0 00-1.5 0v2.5A2.75 2.75 0 004.75 18h10.5A2.75 2.75 0 0018 15.25v-2.5a.75.75 0 00-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5z" />
          </svg>
          <span>{t.hero.downloadCta}</span>
        </a>

        <a href="#showcase" class="action-pill-secondary">
          <span>{t.hero.sandboxCta}</span>
          <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

      <!-- Keycap quick hint -->
      <div class="quick-hint">
        <span class="hint-text">{t.hero.instantSnapHint}</span>
        <span class="key-pill">⌃</span>
        <span class="key-pill">⌥</span>
        <span class="key-pill">← / →</span>
        <span class="hint-text hint-divider">|</span>
        <span class="hint-text">{t.hero.quakeHint}</span>
        <span class="key-pill">⌥</span>
        <span class="key-pill">Space</span>
      </div>
    </section>

    <!-- Anchors & Sections -->
    <div class="page-container sections-container">
      <section id="showcase" class="section-card">
        <div class="section-header">
          <span class="section-tag">{t.sections.showcase.tag}</span>
          <h2 class="section-title">{t.sections.showcase.title}</h2>
          <p class="section-desc">{t.sections.showcase.desc}</p>
        </div>
        <div class="simulator-mount-container">
          <DesktopSimulator lang={lang} />
        </div>
      </section>

      <section id="features" class="section-card">
        <div class="section-header">
          <span class="section-tag">{t.sections.features.tag}</span>
          <h2 class="section-title">{t.sections.features.title}</h2>
          <p class="section-desc">{t.sections.features.desc}</p>
        </div>
        <MetricsProof lang={lang} />
        <BentoGrid lang={lang} />
      </section>

      <section id="shortcuts" class="section-card">
        <div class="section-header">
          <span class="section-tag">{t.sections.shortcuts.tag}</span>
          <h2 class="section-title">{t.sections.shortcuts.title}</h2>
          <p class="section-desc">{t.sections.shortcuts.desc}</p>
        </div>
        <ShortcutMatrix lang={lang} />
      </section>

      <section id="download" class="section-card">
        <div class="section-header">
          <span class="section-tag">{t.sections.download.tag}</span>
          <h2 class="section-title">{t.sections.download.title}</h2>
          <p class="section-desc">{t.sections.download.desc}</p>
        </div>
        <DistributionHub lang={lang} />
      </section>
    </div>
  </main>

  <Footer lang={lang} />
  <BackToTop lang={lang} />
</BaseLayout>

<style>
  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 80px;
    padding-bottom: 80px;
  }

  /* Hero Section */
  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 80px;
    padding-bottom: 20px;
    max-width: 860px;
  }

  .hero-badge-wrapper {
    margin-bottom: 24px;
  }

  .badge-separator {
    color: var(--accent-blue);
    margin: 0 4px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(38px, 6vw, 64px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin-bottom: 20px;
  }

  .hero-highlight {
    color: var(--accent-blue);
  }

  .hero-subtitle {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 680px;
    margin-bottom: 36px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .quick-hint {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-tertiary);
    padding: 8px 16px;
    background-color: var(--surface-color);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-color);
  }

  .hint-divider {
    margin: 0 4px;
    color: var(--border-color);
  }

  /* Sections Container */
  .sections-container {
    display: flex;
    flex-direction: column;
    gap: 88px;
  }

  .section-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-blue);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 3.5vw, 30px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .section-desc {
    font-size: 14px;
    color: var(--text-secondary);
    max-width: 600px;
  }

  @media (max-width: 640px) {
    .main-content {
      gap: 56px;
      padding-bottom: 56px;
    }

    .hero-section {
      padding-top: 48px;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions .action-pill,
    .hero-actions .action-pill-secondary {
      width: 100%;
    }
  }
</style>
