---
// BackToTop.astro: Floating Scroll-Progress & Back-to-Top Action
interface Props {
  lang?: 'en' | 'vi';
}

const { lang = 'en' } = Astro.props;
const label = lang === 'vi' ? 'Lên đầu trang' : 'Back to top';
---

<button
  id="back-to-top"
  class="back-to-top-btn"
  type="button"
  aria-label={label}
  title={label}
>
  <svg class="progress-ring" viewBox="0 0 36 36" width="36" height="36" aria-hidden="true">
    <circle class="ring-bg" cx="18" cy="18" r="15" fill="none" stroke-width="2.5" />
    <circle
      class="ring-indicator"
      id="progress-indicator"
      cx="18"
      cy="18"
      r="15"
      fill="none"
      stroke-width="2.5"
      stroke-dasharray="94.2"
      stroke-dashoffset="94.2"
    />
  </svg>
  <svg class="arrow-icon" viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
    <path
      fill-rule="evenodd"
      d="M10 17a.75.75 0 01-.75-.75V5.612L5.29 9.77a.75.75 0 01-1.08-1.04l5.25-5.5a.75.75 0 011.08 0l5.25 5.5a.75.75 0 11-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0110 17z"
      clip-rule="evenodd"
    />
  </svg>
</button>

<style>
  .back-to-top-btn {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full, 9999px);
    background-color: var(--surface-elevated, #18181b);
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
    color: var(--text-primary, #f4f4f5);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 40;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.9);
    transition:
      opacity var(--duration-normal, 250ms) ease,
      transform var(--duration-normal, 250ms) var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
      visibility var(--duration-normal, 250ms),
      border-color var(--duration-fast, 150ms) ease,
      box-shadow var(--duration-fast, 150ms) ease;
    box-shadow: var(--shadow-md, 0 4px 12px -2px rgba(0, 0, 0, 0.12));
    padding: 0;
  }

  .back-to-top-btn.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .back-to-top-btn:hover {
    border-color: var(--border-focus, #0a84ff);
    transform: translateY(-2px) scale(1.05);
    box-shadow: var(--shadow-lg, 0 20px 25px -5px rgba(0, 0, 0, 0.25));
  }

  .back-to-top-btn:active {
    transform: scale(0.95);
  }

  .progress-ring {
    position: absolute;
    top: 3px;
    left: 3px;
    transform: rotate(-90deg);
    pointer-events: none;
  }

  .ring-bg {
    stroke: var(--border-subtle, rgba(255, 255, 255, 0.04));
  }

  .ring-indicator {
    stroke: var(--accent-blue, #0a84ff);
    stroke-linecap: round;
    transition: stroke-dashoffset 80ms linear;
  }

  .arrow-icon {
    position: relative;
    z-index: 1;
    transition: transform var(--duration-fast, 150ms) ease;
  }

  .back-to-top-btn:hover .arrow-icon {
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .back-to-top-btn {
      bottom: 20px;
      right: 20px;
      width: 40px;
      height: 40px;
    }
    .progress-ring {
      top: 1px;
      left: 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top-btn {
      transition: none !important;
    }
    .ring-indicator {
      transition: none !important;
    }
  }
</style>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top');
    const indicator = document.getElementById('progress-indicator') as SVGCircleElement | null;
    if (!btn || !indicator) return;

    const circumference = 94.2; // 2 * Math.PI * 15

    let ticking = false;
    function updateScrollProgress() {
      const scrollY = window.scrollY;
      const totalScrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = totalScrollable > 0 ? Math.min(1, Math.max(0, scrollY / totalScrollable)) : 0;

      indicator!.style.strokeDashoffset = String(circumference - progress * circumference);

      if (progress > 0.35) {
        btn!.classList.add('is-visible');
      } else {
        btn!.classList.remove('is-visible');
      }
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateScrollProgress);
          ticking = true;
        }
      },
      { passive: true }
    );

    btn.addEventListener('click', () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
    });

    updateScrollProgress();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBackToTop);
  } else {
    setupBackToTop();
  }

  document.addEventListener('astro:after-swap', setupBackToTop);
</script>
