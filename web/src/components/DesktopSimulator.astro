---
/**
 * DesktopSimulator.astro
 * 3D Interactive macOS Desktop Simulator (Hero Showcase)
 * Feature: web-desktop-sandbox (US-WEB-026)
 *
 * Implements hardware-accelerated CSS 3D transforms, multi-window concurrency (VS Code & Terminal),
 * authentic FlowSnap Menu Bar popover, Windows 11-style top-edge layout picker with true 70/30 proportions,
 * liquid glass HUD snap preview, and buttery 120 FPS pointer drag physics.
 */
import { getI18n, type Locale } from '../i18n';
import '../styles/desktop-simulator.css';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getI18n(lang);
---

<div class="simulator-wrapper" id="desktop-simulator-root">
  <!-- Mobile / Touch-Only Fallback Card -->
  <div class="mobile-fallback-card" role="region" aria-label="macOS Desktop Preview">
    <div class="mobile-fallback-banner">
      <div class="banner-icon-wrap" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
          <path fill-rule="evenodd" d="M2 4.5A2.5 2.5 0 014.5 2h11A2.5 2.5 0 0118 4.5v8a2.5 2.5 0 01-2.5 2.5h-3.25a.75.75 0 000 1.5H13a.75.75 0 010 1.5H7a.75.75 0 010-1.5h.75a.75.75 0 000-1.5H4.5A2.5 2.5 0 012 12.5v-8zm2.5-1a1 1 0 00-1 1v8a1 1 0 001 1h11a1 1 0 001-1v-8a1 1 0 00-1-1h-11z" clip-rule="evenodd" />
        </svg>
      </div>
      <p class="banner-text">{t.sections.showcase.mobileFallback}</p>
    </div>

    <div class="static-preview-frame">
      <div class="static-menubar">
        <div class="static-menubar-left">
          <svg class="apple-logo" viewBox="0 0 170 170" width="11" height="11" fill="currentColor">
            <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.04-7.7-7.85-12-14.44-6-9.19-10.74-19.8-14.22-31.85-3.48-12.04-5.22-23.3-5.22-33.78 0-14.07 3.51-25.96 10.53-35.68 7.02-9.72 16.03-14.67 27.02-14.86 4.79 0 10.37 1.34 16.74 4.02 6.37 2.68 10.22 4.07 11.55 4.17 1.56-.1 5.68-1.57 12.35-4.42 6.67-2.85 12.44-4.14 17.31-3.87 13.06.74 23.47 5.67 31.23 14.8-11.44 6.89-17.06 16.38-16.86 28.47.2 9.53 3.91 17.51 11.13 23.94 7.22 6.43 15.65 10.05 25.29 10.86-2.12 6.55-4.68 13.5-7.68 20.86zM119.22 31.84c0-7.72 2.76-14.88 8.28-21.48 5.53-6.61 12.32-10.36 20.37-11.26.2 1.13.3 2.22.3 3.27 0 7.6-2.93 14.85-8.79 21.75-5.86 6.9-12.83 10.72-20.9 11.46-.2-1.22-.26-2.47-.26-3.74z" />
          </svg>
          <span class="static-app-name">FlowSnap</span>
        </div>
        <div class="static-menubar-right">
          <span class="static-clock">09:41</span>
        </div>
      </div>

      <div class="static-split-stage">
        <!-- 70% Left: Code Window -->
        <div class="static-window static-win-code">
          <div class="static-win-header">
            <div class="traffic-lights">
              <span class="traffic-light red"></span>
              <span class="traffic-light yellow"></span>
              <span class="traffic-light green"></span>
            </div>
            <span class="static-win-title">SnapEngine.swift</span>
            <span class="static-badge">70% Zone</span>
          </div>
          <div class="static-code-content">
            <pre><code><span class="token-comment">// FlowSnap Core Engine</span>
<span class="token-keyword">import</span> <span class="token-type">Cocoa</span>

<span class="token-attr">@MainActor</span>
<span class="token-keyword">public struct</span> <span class="token-type">SnapEngine</span> &#123;
    <span class="token-keyword">public static let</span> shared = <span class="token-type">SnapEngine</span>()
    <span class="token-keyword">public func</span> <span class="token-func">snap</span>(to zone: <span class="token-type">LayoutZone</span>) &#123;
        <span class="token-comment">// Hardware-accelerated 70/30</span>
    &#125;
&#125;</code></pre>
          </div>
        </div>

        <!-- 30% Right: Terminal Window -->
        <div class="static-window static-win-terminal">
          <div class="static-win-header">
            <div class="traffic-lights">
              <span class="traffic-light red"></span>
              <span class="traffic-light yellow"></span>
              <span class="traffic-light green"></span>
            </div>
            <span class="static-win-title">zsh</span>
            <span class="static-badge">30%</span>
          </div>
          <div class="static-terminal-content">
            <div class="t-line"><span class="t-prompt">➜</span> <span class="t-cmd">flowsnap status</span></div>
            <div class="t-line t-output"><span class="t-green">✔</span> Active (Zero Private APIs)</div>
            <div class="t-line t-output"><span class="t-blue">ℹ</span> Snap: 70/30 Active</div>
            <div class="t-line"><span class="t-prompt">➜</span> <span class="t-cursor">_</span></div>
          </div>
        </div>
      </div>

      <!-- Static Dock -->
      <div class="static-dock">
        <div class="static-dock-pill">
          <div class="static-dock-icon active" title="FlowSnap">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <rect x="3" y="4" width="8.5" height="16" rx="2" fill="#0a84ff" />
              <rect x="12.5" y="4" width="8.5" height="16" rx="2" fill="#0071e3" fill-opacity="0.6" />
              <circle cx="7.25" cy="7" r="1" fill="#ffffff" />
            </svg>
          </div>
          <div class="static-dock-icon" title="Code">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="#007acc">
              <path d="M17.5 2.5 7.5 10.5 3 7l-1 1 4.5 4-4.5 4 1 1 4.5-3.5 10 8 4-2V4.5l-4-2zm0 4.5v10l-6-5 6-5z" />
            </svg>
          </div>
          <div class="static-dock-icon" title="Terminal">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="#18181b">
              <rect x="2" y="4" width="20" height="16" rx="3" fill="#1f1f23" stroke="rgba(255,255,255,0.2)" />
              <path d="m6 9 3 3-3 3M11 15h6" stroke="#10b981" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Sandbox Controls / Header Toolbar -->
  <div class="sandbox-toolbar">
    <div class="toolbar-hint">
      <span class="hint-pulse"></span>
      <span class="hint-text">
        <strong>Interactive Sandbox:</strong> Drag any window to top edge to snap, or click <strong>FlowSnap icon</strong> on Menu Bar/Dock.
      </span>
    </div>

    <div class="toolbar-actions">
      <!-- Quick Snap Action Chips -->
      <div class="quick-chips" role="group" aria-label="Quick Snap Presets">
        <button type="button" class="chip-btn" data-snap-action="split-50" aria-label="Balanced Split 50/50">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
            <rect x="2" y="3" width="5.5" height="10" rx="1.5" fill="#0a84ff" />
            <rect x="8.5" y="3" width="5.5" height="10" rx="1.5" fill="#0a84ff" />
          </svg>
          <span>Balanced Split (50/50)</span>
        </button>

        <button type="button" class="chip-btn" data-snap-action="coding-preset" aria-label="Apply Coding Preset 70/30 Split">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
            <rect x="2" y="3" width="7.5" height="10" rx="1.5" fill="#0a84ff" />
            <rect x="10.5" y="3" width="3.5" height="10" rx="1.5" fill="#10b981" />
          </svg>
          <span>Coding Split (70/30)</span>
        </button>

        <button type="button" class="chip-btn" data-snap-action="left-50" aria-label="Snap Focused Window Left 50%">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
            <rect x="2" y="3" width="5.5" height="10" rx="1.5" />
            <rect x="8.5" y="3" width="5.5" height="10" rx="1.5" fill-opacity="0.3" />
          </svg>
          <span>50/50 Left</span>
        </button>

        <button type="button" class="chip-btn" data-snap-action="right-50" aria-label="Snap Focused Window Right 50%">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
            <rect x="2" y="3" width="5.5" height="10" rx="1.5" fill-opacity="0.3" />
            <rect x="8.5" y="3" width="5.5" height="10" rx="1.5" />
          </svg>
          <span>50/50 Right</span>
        </button>

        <button type="button" class="chip-btn" data-snap-action="left-70" aria-label="Snap Focused Window 70% Wide">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
            <rect x="2" y="3" width="8" height="10" rx="1.5" />
            <rect x="11" y="3" width="3" height="10" rx="1.5" fill-opacity="0.3" />
          </svg>
          <span>70/30 Wide</span>
        </button>
      </div>

      <!-- Reset Sandbox Button -->
      <button type="button" class="reset-btn" id="simulator-reset-btn" aria-label="Reset Sandbox to default position">
        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M2.5 8a5.5 5.5 0 1 0 1.6-3.9L2 6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M2 2.5v3.5h3.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>Reset Sandbox</span>
      </button>
    </div>
  </div>

  <!-- 3D Perspective Viewport -->
  <div class="perspective-stage" id="perspective-stage">
    <!-- Simulated macOS Desktop Screen Frame -->
    <div class="mac-desktop-frame" id="mac-desktop-frame" role="region" aria-label="Interactive macOS Desktop Simulator">
      <!-- Dynamic Bezel Specular Glare Reflection -->
      <div class="bezel-glare" id="bezel-glare"></div>

      <!-- Virtual macOS Menu Bar -->
      <header class="mac-menubar">
        <div class="menubar-left">
          <svg class="apple-logo" viewBox="0 0 170 170" width="12" height="12" fill="currentColor">
            <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.04-7.7-7.85-12-14.44-6-9.19-10.74-19.8-14.22-31.85-3.48-12.04-5.22-23.3-5.22-33.78 0-14.07 3.51-25.96 10.53-35.68 7.02-9.72 16.03-14.67 27.02-14.86 4.79 0 10.37 1.34 16.74 4.02 6.37 2.68 10.22 4.07 11.55 4.17 1.56-.1 5.68-1.57 12.35-4.42 6.67-2.85 12.44-4.14 17.31-3.87 13.06.74 23.47 5.67 31.23 14.8-11.44 6.89-17.06 16.38-16.86 28.47.2 9.53 3.91 17.51 11.13 23.94 7.22 6.43 15.65 10.05 25.29 10.86-2.12 6.55-4.68 13.5-7.68 20.86zM119.22 31.84c0-7.72 2.76-14.88 8.28-21.48 5.53-6.61 12.32-10.36 20.37-11.26.2 1.13.3 2.22.3 3.27 0 7.6-2.93 14.85-8.79 21.75-5.86 6.9-12.83 10.72-20.9 11.46-.2-1.22-.26-2.47-.26-3.74z" />
          </svg>
          <span class="app-name">FlowSnap</span>
          <nav class="dummy-menus">
            <span class="menu-item">File</span>
            <span class="menu-item">Edit</span>
            <span class="menu-item">Layout</span>
            <span class="menu-item">Window</span>
            <span class="menu-item">Help</span>
          </nav>
        </div>

        <div class="menubar-right">
          <!-- FlowSnap Status Item (Clickable Popover Trigger) -->
          <div class="status-icon fs-status-icon" id="fs-menubar-trigger" role="button" tabindex="0" aria-label="Open FlowSnap Menu Bar Grid" title="Click to open FlowSnap Menu Bar Grid">
            <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor">
              <rect x="2" y="3" width="5.5" height="10" rx="1" />
              <rect x="8.5" y="3" width="5.5" height="10" rx="1" fill-opacity="0.4" />
            </svg>
            <span class="status-dot"></span>
          </div>

          <!-- Wi-Fi Icon -->
          <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" class="status-icon">
            <path d="M8 12.5a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5zm-3.5-2.75a4.95 4.95 0 0 1 7 0 .75.75 0 0 0 1.06-1.06 6.45 6.45 0 0 0-9.12 0 .75.75 0 0 0 1.06 1.06zm-2.5-2.75a8.45 8.45 0 0 1 12 0 .75.75 0 0 0 1.06-1.06 9.95 9.95 0 0 0-14.12 0 .75.75 0 0 0 1.06 1.06z" />
          </svg>

          <!-- Battery Icon -->
          <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" class="status-icon">
            <path d="M2 5a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H2zm13 3a1 1 0 0 0-1-1v2a1 1 0 0 1 1-1zM2 6.5h10a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.5.5H2a.5.5 0 0 1-.5-.5V7a.5.5 0 0 1 .5-.5z" />
            <rect x="3" y="7.5" width="6.5" height="1" rx="0.5" fill="currentColor" />
          </svg>

          <!-- Virtual Clock -->
          <span class="virtual-clock" id="virtual-clock">09:41</span>
        </div>

        <!-- FlowSnap Native Menu Bar Popover Dropdown -->
        <div class="fs-menubar-popover" id="fs-menubar-popover" aria-hidden="true">
          <div class="popover-header">
            <div class="popover-title-row">
              <span class="popover-brand">FlowSnap Menu</span>
              <span class="popover-badge">v1.3.1</span>
            </div>
            <span class="popover-focus-label">Target: <strong id="popover-target-name">SnapEngine.swift</strong></span>
          </div>

          <div class="popover-section-title">Visual Snap Grid</div>
          <div class="popover-grid">
            <button type="button" class="popover-grid-btn" data-popover-snap="left-50" title="Snap Left 50%">
              <div class="tile-icon split-left"></div>
              <span>Left 1/2</span>
            </button>
            <button type="button" class="popover-grid-btn" data-popover-snap="right-50" title="Snap Right 50%">
              <div class="tile-icon split-right"></div>
              <span>Right 1/2</span>
            </button>
            <button type="button" class="popover-grid-btn" data-popover-snap="left-70" title="Snap Left 70%">
              <div class="tile-icon split-70"></div>
              <span>Left 70%</span>
            </button>
            <button type="button" class="popover-grid-btn" data-popover-snap="right-30" title="Snap Right 30%">
              <div class="tile-icon split-30"></div>
              <span>Right 30%</span>
            </button>
            <button type="button" class="popover-grid-btn" data-popover-snap="center-50" title="Center 50%">
              <div class="tile-icon split-center"></div>
              <span>Center 1/2</span>
            </button>
            <button type="button" class="popover-grid-btn" data-popover-snap="maximize" title="Maximize">
              <div class="tile-icon split-max"></div>
              <span>Maximize</span>
            </button>
          </div>

          <div class="popover-divider"></div>

          <div class="popover-section-title">Dual Window Presets</div>
          <div class="popover-presets">
            <button type="button" class="preset-row-btn" data-popover-preset="coding">
              <div class="preset-info">
                <span class="preset-name">Coding Workspace</span>
                <span class="preset-desc">Code Editor 70% • Terminal 30%</span>
              </div>
              <span class="preset-keycap">⌃⌥C</span>
            </button>
            <button type="button" class="preset-row-btn" data-popover-preset="research">
              <div class="preset-info">
                <span class="preset-name">Balanced Side-by-Side</span>
                <span class="preset-desc">Code Editor 50% • Terminal 50%</span>
              </div>
              <span class="preset-keycap">⌃⌥R</span>
            </button>
          </div>
        </div>
      </header>

      <!-- Desktop Usable Workspace -->
      <div class="mac-workspace" id="mac-workspace">
        <!-- Windows 11-Style Top-Edge Snap Picker -->
        <div class="snap-picker" id="snap-picker" aria-hidden="true">
          <div class="picker-header">
            <span class="picker-title">FlowSnap Smart Layouts</span>
            <span class="picker-badge">Release to Snap</span>
          </div>

          <div class="picker-templates-grid">
            <!-- Template 1: Two Columns Equal (50 / 50) -->
            <div class="template-card" data-template-name="2 Columns (50/50)">
              <div class="template-preview">
                <div class="snap-zone-btn" role="button" tabindex="0" aria-label="Snap Left 50%" data-zone-id="two-col-left" data-left="0" data-top="0" data-width="50" data-height="100" data-label="Left 50%"></div>
                <div class="snap-zone-btn" role="button" tabindex="0" aria-label="Snap Right 50%" data-zone-id="two-col-right" data-left="50" data-top="0" data-width="50" data-height="100" data-label="Right 50%"></div>
              </div>
              <span class="template-label">50 / 50</span>
            </div>

            <!-- Template 2: Two Columns Asymmetric (70 / 30) - PROPORTIONAL FIX -->
            <div class="template-card" data-template-name="2 Columns (70/30)">
              <div class="template-preview preview-70-30">
                <div class="snap-zone-btn zone-70" role="button" tabindex="0" aria-label="Snap Left 70%" data-zone-id="two-col-asym-left" data-left="0" data-top="0" data-width="70" data-height="100" data-label="Left 70%"></div>
                <div class="snap-zone-btn zone-30" role="button" tabindex="0" aria-label="Snap Right 30%" data-zone-id="two-col-asym-right" data-left="70" data-top="0" data-width="30" data-height="100" data-label="Right 30%"></div>
              </div>
              <span class="template-label">70 / 30</span>
            </div>

            <!-- Template 3: Three Columns (25 / 50 / 25) - PROPORTIONAL FIX -->
            <div class="template-card" data-template-name="3 Columns (25/50/25)">
              <div class="template-preview preview-25-50-25">
                <div class="snap-zone-btn zone-25" role="button" tabindex="0" aria-label="Snap Left 25%" data-zone-id="three-col-left" data-left="0" data-top="0" data-width="25" data-height="100" data-label="Left 25%"></div>
                <div class="snap-zone-btn zone-50" role="button" tabindex="0" aria-label="Snap Center 50%" data-zone-id="three-col-center" data-left="25" data-top="0" data-width="50" data-height="100" data-label="Center 50%"></div>
                <div class="snap-zone-btn zone-25" role="button" tabindex="0" aria-label="Snap Right 25%" data-zone-id="three-col-right" data-left="75" data-top="0" data-width="25" data-height="100" data-label="Right 25%"></div>
              </div>
              <span class="template-label">25 / 50 / 25</span>
            </div>

            <!-- Template 4: Four Quarters (25% each) -->
            <div class="template-card" data-template-name="4 Quarters">
              <div class="template-preview grid-quarters">
                <div class="snap-zone-btn" role="button" tabindex="0" aria-label="Snap Top Left 25%" data-zone-id="quarter-top-left" data-left="0" data-top="0" data-width="50" data-height="50" data-label="Top Left 25%"></div>
                <div class="snap-zone-btn" role="button" tabindex="0" aria-label="Snap Top Right 25%" data-zone-id="quarter-top-right" data-left="50" data-top="0" data-width="50" data-height="50" data-label="Top Right 25%"></div>
                <div class="snap-zone-btn" role="button" tabindex="0" aria-label="Snap Bottom Left 25%" data-zone-id="quarter-bottom-left" data-left="0" data-top="50" data-width="50" data-height="50" data-label="Bottom Left 25%"></div>
                <div class="snap-zone-btn" role="button" tabindex="0" aria-label="Snap Bottom Right 25%" data-zone-id="quarter-bottom-right" data-left="50" data-top="50" data-width="50" data-height="50" data-label="Bottom Right 25%"></div>
              </div>
              <span class="template-label">4 Corners</span>
            </div>
          </div>
        </div>

        <!-- Translucent Liquid Glass HUD Snap Preview Overlay -->
        <div class="hud-snap-preview" id="hud-snap-preview" aria-hidden="true">
          <div class="hud-preview-content">
            <span class="hud-preview-badge" id="hud-preview-badge">Left 50%</span>
          </div>
        </div>

        <!-- WINDOW 1: Mini Code Editor (VS Code) -->
        <div class="mock-window active-window" id="mock-window-code" data-window-name="SnapEngine.swift">
          <div class="mock-titlebar" id="titlebar-code" title="Drag to move SnapEngine.swift">
            <div class="traffic-lights">
              <button type="button" class="traffic-light red" data-win-action="close" aria-label="Close window" title="Close window"></button>
              <button type="button" class="traffic-light yellow" data-win-action="minimize" aria-label="Minimize window" title="Minimize to dock"></button>
              <button type="button" class="traffic-light green" data-win-action="maximize" aria-label="Toggle maximize" title="Toggle maximize"></button>
            </div>
            <div class="titlebar-info">
              <svg class="file-icon" viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                <path d="M4 1.5A1.5 1.5 0 0 0 2.5 3v10A1.5 1.5 0 0 0 4 14.5h8a1.5 1.5 0 0 0 1.5-1.5V6L9 1.5H4zm5 1V5a1 1 0 0 0 1 1h2.5L9 2.5z" />
              </svg>
              <span class="titlebar-text">SnapEngine.swift</span>
            </div>
            <div class="snap-status-badge">
              <span class="status-pulse-dot"></span>
              <span class="status-label status-label-code">Zone: Free Float</span>
            </div>
          </div>

          <div class="mock-code-body">
            <div class="code-line-numbers">
