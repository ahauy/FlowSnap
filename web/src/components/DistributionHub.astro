---
import UnifiedInstaller from './UnifiedInstaller.astro';
import PrivacyManifesto from './PrivacyManifesto.astro';
import GatekeeperGuide from './GatekeeperGuide.astro';
import type { Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
---

<div id="distribution-hub-root" class="distribution-hub" data-component="distribution-hub">
  <!-- Tier 1: Unified 3-Tab Distribution Hub (DMG, cURL, Homebrew) -->
  <div class="hub-hero-section">
    <UnifiedInstaller lang={lang} />
  </div>

  <!-- Tier 2: Security, Trust & Frictionless Onboarding (Full-Width Symmetrical Flow) -->
  <div class="hub-trust-tier">
    <PrivacyManifesto lang={lang} />
    <GatekeeperGuide lang={lang} />
  </div>
</div>

<style>
  .distribution-hub {
    width: 100%;
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Tier 1: Unified 3-Tab Hero Card Section */
  .hub-hero-section {
    width: 100%;
    display: flex;
  }

  .hub-hero-section > :global(*) {
    width: 100%;
  }

  /* Tier 2: Full-width Trust & Security Stack */
  .hub-trust-tier {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }
</style>
