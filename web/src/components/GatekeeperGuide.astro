---
import { GATEKEEPER_DATA } from '../data/distribution-data';
import { getI18n, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getI18n(lang);
---

<div class="gatekeeper-wrapper" data-component="gatekeeper-guide">
  <details class="gatekeeper-details" id="gatekeeper-details">
    <summary class="gatekeeper-summary">
      <div class="summary-left">
        <div class="summary-icon-wrap" aria-hidden="true">
          <svg class="shield-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
        </div>
        <div class="summary-text-group">
          <div class="title-row">
            <span class="summary-title">{t.distribution.gatekeeper.title}</span>
            <span class="gatekeeper-badge">Gatekeeper Help</span>
          </div>
          <span class="summary-hint">{t.distribution.gatekeeper.hint}</span>
        </div>
      </div>

      <div class="summary-right">
        <span class="toggle-label">{t.distribution.gatekeeper.toggleLabel}</span>
        <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </div>
    </summary>

    <div class="gatekeeper-body">
      <p class="gatekeeper-desc">{t.distribution.gatekeeper.summary}</p>

      <div class="steps-row">
        {t.distribution.gatekeeper.steps.map((step) => (
          <div class="step-pane">
            <div class="step-top-content">
              <div class="step-header">
                <span class="step-num" aria-hidden="true">{step.stepNumber}</span>
                <h5 class="step-title">{step.title}</h5>
              </div>
              <p class="step-instruction">{step.instruction}</p>
            </div>
            
            {step.stepNumber === 2 && (
              <div class="command-box">
                <span class="prompt" aria-hidden="true">$</span>
                <code class="code-snippet" id="gatekeeper-command">{GATEKEEPER_DATA.command}</code>
                <button
                  type="button"
                  class="gatekeeper-copy-btn"
                  id="gatekeeper-copy-btn"
                  data-copy-trigger="gatekeeper"
                  data-command={GATEKEEPER_DATA.command}
                  aria-label={t.distribution.gatekeeper.copyAria}
                >
                  <svg class="copy-icon icon-neutral" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                  <svg class="copy-icon icon-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span class="copy-text">{t.shortcuts.controls.copyLabel}</span>
                </button>
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="sr-only" aria-live="polite" id="gatekeeper-copy-status"></div>
    </div>
  </details>
</div>

<script>
  function initGatekeeperGuide() {
    const copyBtn = document.getElementById('gatekeeper-copy-btn') as HTMLButtonElement | null;
    const status = document.getElementById('gatekeeper-copy-status');
    const command = copyBtn?.getAttribute('data-command') || '';
    const defaultCopyText = copyBtn?.querySelector('.copy-text')?.textContent || 'Copy';

    copyBtn?.addEventListener('click', async (e) => {
      e.stopPropagation();
      if (!command) return;

      let success = false;
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(command);
          success = true;
        } catch {
          success = fallbackCopy(command);
        }
      } else {
        success = fallbackCopy(command);
      }

      if (success) {
        copyBtn.classList.add('copied');
        const textSpan = copyBtn.querySelector('.copy-text');
        if (textSpan) textSpan.textContent = 'Copied!';
        if (status) status.textContent = 'xattr command copied to clipboard!';

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          if (textSpan) textSpan.textContent = defaultCopyText;
          if (status) status.textContent = '';
        }, 2000);
      }
    });

    function fallbackCopy(text: string): boolean {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.left = '-999999px';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      let res = false;
      try {
        res = document.execCommand('copy');
      } catch {
        res = false;
      }
      document.body.removeChild(ta);
      return res;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGatekeeperGuide);
  } else {
    initGatekeeperGuide();
  }
</script>

<style>
  .gatekeeper-wrapper {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-normal);
    width: 100%;
    box-shadow: var(--shadow-sm);
  }

  .gatekeeper-wrapper:hover {
    border-color: rgba(255, 255, 255, 0.18);
  }

  :global(.light) .gatekeeper-wrapper:hover {
    border-color: rgba(0, 0, 0, 0.16);
  }

  .gatekeeper-details {
    width: 100%;
  }

  .gatekeeper-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background var(--transition-fast);
  }

  .gatekeeper-summary::-webkit-details-marker {
    display: none;
  }

  .gatekeeper-summary:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  :global(.light) .gatekeeper-summary:hover {
    background: rgba(0, 0, 0, 0.02);
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .summary-icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: rgba(255, 214, 10, 0.12);
    border: 1px solid rgba(255, 214, 10, 0.25);
    color: var(--color-warning);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .summary-text-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .summary-title {
    font-size: var(--font-sm);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .gatekeeper-badge {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-warning);
    background: rgba(255, 214, 10, 0.1);
    border: 1px solid rgba(255, 214, 10, 0.25);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
  }

  .summary-hint {
    font-size: 11px;
    color: var(--color-text-tertiary);
  }

  .summary-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .toggle-label {
    font-size: 11px;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
  }

  .chevron-icon {
    color: var(--color-text-tertiary);
    transition: transform var(--transition-normal);
  }

  .gatekeeper-details[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .gatekeeper-body {
    padding: 20px 24px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 1px solid var(--color-border);
  }

  .gatekeeper-desc {
    font-size: var(--font-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .steps-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }

  .step-pane {
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    transition: border-color var(--transition-fast);
    min-width: 0;
    height: 100%;
  }

  .step-pane:hover {
    border-color: rgba(255, 255, 255, 0.16);
  }

  :global(.light) .step-pane:hover {
    border-color: rgba(0, 0, 0, 0.14);
  }

  .step-top-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .step-num {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-size: 11px;
    font-weight: 700;
    font-family: var(--font-mono);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-title {
    font-size: var(--font-xs);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
  }

  .step-instruction {
    font-size: 11px;
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .command-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #0d0e14;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    margin-top: 6px;
  }

  :global(.light) .command-box {
    background: #151720;
    border-color: rgba(0, 0, 0, 0.15);
  }

  .prompt {
    color: var(--color-warning);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    user-select: none;
  }

  .code-snippet {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #f4f4f5;
    overflow-x: auto;
    white-space: nowrap;
  }

  .gatekeeper-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #f4f4f5;
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .gatekeeper-copy-btn:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .gatekeeper-copy-btn .icon-success {
    display: none;
  }

  .gatekeeper-copy-btn.copied {
    background: rgba(48, 209, 88, 0.18);
    border-color: rgba(48, 209, 88, 0.4);
    color: var(--color-success);
  }

  .gatekeeper-copy-btn.copied .icon-neutral {
    display: none;
  }

  .gatekeeper-copy-btn.copied .icon-success {
    display: inline-block;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media (max-width: 1023px) {
    .steps-row {
      grid-template-columns: 1fr;
    }

    .gatekeeper-summary {
      padding: 16px 20px;
    }

    .gatekeeper-body {
      padding: 16px 20px 20px 20px;
    }
  }
</style>
