---
import { RELEASE_METADATA } from '../data/distribution-data';
---

<div class="dmg-card" data-component="dmg-card">
  <div class="dmg-card-inner">
    <!-- Top Identity Section -->
    <div class="card-identity-block">
      <div class="card-header">
        <div class="app-brand">
          <div class="app-icon-squircle" aria-hidden="true">
            <svg class="flowsnap-logo" viewBox="0 0 44 44" fill="none" width="44" height="44">
              <rect width="44" height="44" rx="11" fill="url(#dmgAppGrad)" />
              <!-- Subtle specular top gloss -->
              <rect x="1" y="1" width="42" height="21" rx="10" fill="url(#specularGloss)" />
              <!-- Window layout icon glyphs -->
              <rect x="8" y="8" width="12" height="28" rx="3" fill="white" fill-opacity="0.95" />
              <rect x="24" y="8" width="12" height="12.5" rx="3" fill="white" fill-opacity="0.75" />
              <rect x="24" y="23.5" width="12" height="12.5" rx="3" fill="white" fill-opacity="0.75" />
              <defs>
                <linearGradient id="dmgAppGrad" x1="0" y1="0" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#0A84FF" />
                  <stop offset="1" stop-color="#0058D0" />
                </linearGradient>
                <linearGradient id="specularGloss" x1="22" y1="1" x2="22" y2="22" gradientUnits="userSpaceOnUse">
                  <stop stop-color="white" stop-opacity="0.25" />
                  <stop offset="1" stop-color="white" stop-opacity="0" />
                </linearGradient>
              </defs>
            </svg>
          </div>

          <div class="brand-text">
            <div class="badge-row">
              <span class="version-badge">
                <span class="pulse-dot" aria-hidden="true"></span>
                {RELEASE_METADATA.version}
              </span>
              <span class="release-date">{RELEASE_METADATA.releaseDate}</span>
            </div>
            <h3 class="dmg-title">Official macOS Disk Image</h3>
          </div>
        </div>

        <span class="license-tag">{RELEASE_METADATA.license}</span>
      </div>

      <p class="dmg-desc">
        Tải trực tiếp gói cài đặt chuẩn macOS (.dmg) đã biên dịch sẵn với tối ưu hóa đa kiến trúc Apple Silicon & Intel.
      </p>
    </div>

    <!-- Action Section -->
    <div class="cta-wrapper">
      <a
        href={RELEASE_METADATA.dmgUrl}
        class="dmg-download-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Download FlowSnap ${RELEASE_METADATA.version} for macOS (DMG)`}
      >
        <div class="btn-left">
          <div class="apple-icon-wrap" aria-hidden="true">
            <svg class="apple-logo-svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.35-.58.66-.99 1.73-.86 2.76 1.01.08 1.98-.51 2.59-1.26z" />
            </svg>
          </div>
          <div class="btn-copy">
            <span class="btn-headline">Download for macOS</span>
            <span class="btn-specs">{RELEASE_METADATA.fileSize} • {RELEASE_METADATA.version}</span>
          </div>
        </div>

        <div class="btn-right" aria-hidden="true">
          <svg class="download-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
            <path d="M12 3v13M7 11l5 5 5-5" />
            <path d="M4 20h16" />
          </svg>
        </div>
      </a>

      <!-- Hardware Specs Chips -->
      <div class="specs-grid">
        <div class="spec-chip">
          <svg class="spec-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true">
            <rect x="4" y="4" width="16" height="16" rx="2" />
            <rect x="9" y="9" width="6" height="6" />
          </svg>
          <span>{RELEASE_METADATA.binaryArch}</span>
        </div>

        <div class="spec-chip">
          <svg class="spec-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" />
            <line x1="8" y1="21" x2="16" y2="21" />
            <line x1="12" y1="17" x2="12" y2="21" />
          </svg>
          <span>{RELEASE_METADATA.minMacOS}</span>
        </div>
      </div>
    </div>

    <!-- Bottom Verification & Archive Link -->
    <div class="card-footer">
      <div class="checksum-hint">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12" class="shield-check-svg" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
        <span class="hint-label">SHA-256 Checksum Verified</span>
      </div>
      <a
        href={RELEASE_METADATA.releasesPageUrl}
        class="releases-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>View all releases on GitHub</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true">
          <path d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .dmg-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 28px;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .dmg-card:hover {
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow: var(--shadow-md);
  }

  :global(.light) .dmg-card:hover {
    border-color: rgba(0, 0, 0, 0.16);
  }

  .dmg-card-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 22px;
  }

  .card-identity-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Header */
  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .app-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .app-icon-squircle {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(10, 132, 255, 0.32);
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .version-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: rgba(48, 209, 88, 0.12);
    border: 1px solid rgba(48, 209, 88, 0.3);
    color: var(--color-success);
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 6px var(--color-success);
    animation: pulseGlow 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .release-date {
    font-size: 11px;
    color: var(--color-text-tertiary);
  }

  .license-tag {
    font-size: 11px;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .dmg-title {
    font-size: var(--font-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .dmg-desc {
    font-size: var(--font-xs);
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  /* CTA Area */
  .cta-wrapper {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Apple HIG Action Pill */
  .dmg-download-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--color-text-primary);
    color: var(--color-bg);
    padding: 13px 20px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), opacity var(--transition-fast);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.16);
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  :global(.light) .dmg-download-btn {
    border-color: rgba(0, 0, 0, 0.1);
  }

  .dmg-download-btn:hover {
    transform: translateY(-1px) scale(1.01);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
    opacity: 0.98;
  }

  .dmg-download-btn:active {
    transform: translateY(0) scale(0.99);
  }

  .btn-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .apple-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .apple-logo-svg {
    color: var(--color-bg);
  }

  .btn-copy {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .btn-headline {
    font-size: var(--font-sm);
    font-weight: 600;
    line-height: 1.2;
  }

  .btn-specs {
    font-size: 11px;
    opacity: 0.8;
    font-family: var(--font-mono);
  }

  .download-arrow {
    color: var(--color-bg);
    opacity: 0.8;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .dmg-download-btn:hover .download-arrow {
    transform: translateY(2px);
    opacity: 1;
  }

  /* Specs Chips */
  .specs-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .spec-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    font-size: 11px;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
  }

  .spec-icon {
    color: var(--color-text-tertiary);
  }

  /* Footer */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
    font-size: 11px;
  }

  .checksum-hint {
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .shield-check-svg {
    color: var(--color-success);
  }

  .releases-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-text-tertiary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .releases-link:hover {
    color: var(--color-text-primary);
  }

  @media (max-width: 640px) {
    .dmg-card {
      padding: 20px;
    }
  }
</style>
