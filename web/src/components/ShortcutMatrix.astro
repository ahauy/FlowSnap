---
import { shortcutCategories, shortcutsCatalog } from '../data/shortcuts-data';
import { getI18n, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getI18n(lang);

// Localized categories
const localizedCategories = shortcutCategories.map((cat) => ({
  ...cat,
  label: t.shortcuts.categories[cat.key] || cat.label,
}));

// Localized shortcuts catalog
const itemMap = new Map(t.shortcuts.items.map((i) => [i.id, i]));
const localizedCatalog = shortcutsCatalog.map((item, index) => {
  const loc = itemMap.get(item.id);
  return {
    ...item,
    action: loc?.action || item.action,
    description: loc?.description || item.description,
    badge: loc?.badge || item.badge,
    initialIndex: index,
  };
});

// Calculate counts per category
const counts = {
  all: localizedCatalog.length,
  window: localizedCatalog.filter((s) => s.category === 'window').length,
  display: localizedCatalog.filter((s) => s.category === 'display').length,
  workspace: localizedCatalog.filter((s) => s.category === 'workspace').length,
  utility: localizedCatalog.filter((s) => s.category === 'utility').length,
};
---

<div
  id="shortcut-matrix-root"
  class="shortcut-matrix-wrapper"
  role="region"
  aria-label="Interactive Keyboard Shortcuts Matrix"
  data-copy-label={t.shortcuts.controls.copyLabel}
  data-copied-label={t.shortcuts.controls.copiedLabel}
  data-show-all-label={t.shortcuts.controls.showAll}
  data-show-fewer-label={t.shortcuts.controls.showFewer}
>
  <!-- Top Controls Bar: Categories & Search Bar -->
  <div class="matrix-controls-bar">
    <!-- Category Filter Tabs -->
    <div class="category-tabs" role="tablist" aria-label="Shortcut categories">
      {localizedCategories.map((cat, idx) => (
        <button
          type="button"
          class={`cat-tab-btn ${idx === 0 ? 'active' : ''}`}
          data-filter-category={cat.key}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          id={`tab-${cat.key}`}
        >
          <span class="tab-label">{cat.label}</span>
          <span class="tab-count">{counts[cat.key as keyof typeof counts]}</span>
        </button>
      ))}
    </div>

    <!-- Live Search Input -->
    <div class="search-input-wrap">
      <svg class="search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="9" cy="9" r="6" />
        <line x1="13.5" y1="13.5" x2="18" y2="18" />
      </svg>
      <input
        type="text"
        id="shortcut-search-input"
        class="search-input"
        placeholder={t.shortcuts.controls.searchPlaceholder}
        aria-label={t.shortcuts.controls.searchAria}
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" id="shortcut-search-clear" class="search-clear-btn" aria-label={t.shortcuts.controls.clearSearchAria} hidden>
        <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Shortcuts Grid / Directory -->
  <div class="shortcuts-grid" id="shortcuts-grid-container">
    {localizedCatalog.map((item, index) => (
      <div
        class={`shortcut-card ${index >= 6 ? 'is-extra-shortcut' : ''}`}
        data-shortcut-id={item.id}
        data-index={index}
        data-category={item.category}
        data-search-text={`${item.action} ${item.displayString} ${item.description} ${item.keys.join(' ')} ${item.category} ${item.badge || ''}`}
        data-copy-shortcut={item.displayString}
        hidden={index >= 6}
        style={index >= 6 ? 'display: none;' : undefined}
      >
        <div class="shortcut-info">
          <div class="shortcut-header-row">
            <h4 class="shortcut-action">{item.action}</h4>
            {item.badge && <span class="shortcut-badge">{item.badge}</span>}
          </div>
          <p class="shortcut-desc">{item.description}</p>
        </div>

        <div class="shortcut-action-group">
          <!-- Keycap Pills -->
          <div class="keycaps-container" title={t.shortcuts.controls.keycapTitle}>
            {item.keys.map((k) => (
              <kbd class="keycap-pill">{k}</kbd>
            ))}
          </div>

          <!-- Copy Shortcut Action Button -->
          <button
            type="button"
            class="copy-shortcut-btn"
            data-copy-target={item.displayString}
            aria-label={`${t.shortcuts.controls.copyAria} ${item.displayString}`}
          >
            <svg class="copy-icon default-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <svg class="copy-icon check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span class="copy-label">{t.shortcuts.controls.copyLabel}</span>
          </button>
        </div>
      </div>
    ))}
  </div>

  <!-- Expand / Collapse Action Button (Default 6 basic shortcuts) -->
  <div class="expand-action-wrap" id="shortcuts-expand-wrap">
    <button
      type="button"
      id="toggle-shortcuts-expand"
      class="expand-toggle-btn action-pill-secondary"
      aria-expanded="false"
      aria-controls="shortcuts-grid-container"
    >
      <span class="expand-btn-text" id="expand-btn-text">{t.shortcuts.controls.showAll}</span>
      <svg class="expand-chevron" viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>

  <!-- Zero-Match Empty State -->
  <div id="shortcut-empty-state" class="empty-state-card" aria-live="polite" hidden>
    <div class="empty-icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
        <line x1="8" y1="11" x2="14" y2="11" />
      </svg>
    </div>
    <h4 class="empty-title">{t.shortcuts.controls.emptyTitle}</h4>
    <p class="empty-desc">{t.shortcuts.controls.emptyDesc}</p>
    <button type="button" id="shortcut-reset-filter-btn" class="reset-filter-btn">
      {t.shortcuts.controls.resetFilter}
    </button>
  </div>
</div>

<script>
  function normalizeSearch(str: string): string {
    return str
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/đ/g, 'd')
      .trim();
  }

  function setupShortcutMatrix() {
    const root = document.getElementById('shortcut-matrix-root');
    if (!root) return;

    const tabs = root.querySelectorAll<HTMLButtonElement>('.cat-tab-btn');
    const searchInput = document.getElementById('shortcut-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('shortcut-search-clear') as HTMLButtonElement | null;
    const resetFilterBtn = document.getElementById('shortcut-reset-filter-btn') as HTMLButtonElement | null;
    const cards = root.querySelectorAll<HTMLElement>('.shortcut-card');
    const emptyState = document.getElementById('shortcut-empty-state') as HTMLElement | null;
    const copyButtons = root.querySelectorAll<HTMLButtonElement>('.copy-shortcut-btn');
    const keycapContainers = root.querySelectorAll<HTMLElement>('.keycaps-container');
    const expandWrap = document.getElementById('shortcuts-expand-wrap') as HTMLElement | null;
    const toggleExpandBtn = document.getElementById('toggle-shortcuts-expand') as HTMLButtonElement | null;
    const expandBtnText = document.getElementById('expand-btn-text');

    const copyLabel = root.getAttribute('data-copy-label') || 'Copy';
    const copiedLabel = root.getAttribute('data-copied-label') || 'Copied!';
    const showAllLabel = root.getAttribute('data-show-all-label') || 'Show all 15 shortcuts';
    const showFewerLabel = root.getAttribute('data-show-fewer-label') || 'Show fewer shortcuts';

    let currentCategory = 'all';
    let currentSearch = '';
    let isExpanded = false;

    function applyFilter() {
      let visibleCount = 0;
      const query = currentSearch.trim().toLowerCase();
      const normQuery = normalizeSearch(query);
      const isDefaultView = currentCategory === 'all' && query === '';

      if (expandWrap) {
        expandWrap.style.display = isDefaultView ? 'flex' : 'none';
      }

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const rawText = (card.getAttribute('data-search-text') || '').toLowerCase();
        const normText = normalizeSearch(rawText);
        const cardIndex = parseInt(card.getAttribute('data-index') || '0', 10);

        const matchCat = currentCategory === 'all' || cat === currentCategory;
        const matchSearch =
          query === '' ||
          rawText.includes(query) ||
          (normQuery.length > 0 && normText.includes(normQuery));

        if (matchCat && matchSearch) {
          if (isDefaultView && !isExpanded && cardIndex >= 6) {
            card.hidden = true;
            card.style.display = 'none';
          } else {
            card.hidden = false;
            card.style.display = 'flex';
            visibleCount++;
          }
        } else {
          card.hidden = true;
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        const isEmpty = visibleCount === 0;
        emptyState.hidden = !isEmpty;
        emptyState.style.display = isEmpty ? 'flex' : 'none';
      }

      if (clearBtn && searchInput) {
        const hasText = searchInput.value.trim().length > 0;
        clearBtn.hidden = !hasText;
        clearBtn.style.display = hasText ? 'flex' : 'none';
      }
    }

    // Toggle expand button click
    toggleExpandBtn?.addEventListener('click', () => {
      isExpanded = !isExpanded;
      toggleExpandBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
      toggleExpandBtn.classList.toggle('expanded', isExpanded);
      if (expandBtnText) {
        expandBtnText.textContent = isExpanded ? showFewerLabel : showAllLabel;
      }
      applyFilter();
      if (!isExpanded) {
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // Category Tabs click
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        currentCategory = tab.getAttribute('data-filter-category') || 'all';
        applyFilter();
      });
    });

    // Search Input event
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentSearch = searchInput.value;
        applyFilter();
      });

      searchInput.addEventListener('keyup', (e) => {
        if (e.key === 'Escape') {
          searchInput.value = '';
          currentSearch = '';
          applyFilter();
        }
      });
    }

    // Clear Search button
    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentSearch = '';
        searchInput.focus();
        applyFilter();
      });
    }

    // Reset filter button
    if (resetFilterBtn && searchInput) {
      resetFilterBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentSearch = '';
        currentCategory = 'all';
        isExpanded = false;
        toggleExpandBtn?.setAttribute('aria-expanded', 'false');
        toggleExpandBtn?.classList.remove('expanded');
        if (expandBtnText) {
          expandBtnText.textContent = showAllLabel;
        }
        tabs.forEach((t) => {
          const isAll = t.getAttribute('data-filter-category') === 'all';
          t.classList.toggle('active', isAll);
          t.setAttribute('aria-selected', isAll ? 'true' : 'false');
        });
        applyFilter();
      });
    }

    // Clipboard Copy Handler
    async function copyShortcut(text: string, button: HTMLButtonElement | null) {
      if (!text) return;
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(text);
        } else {
          // Fallback
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }

        if (button) {
          button.classList.add('copied');
          const label = button.querySelector('.copy-label');
          if (label) label.textContent = copiedLabel;
          setTimeout(() => {
            button.classList.remove('copied');
            if (label) label.textContent = copyLabel;
          }, 1500);
        }
      } catch (err) {
        console.warn('Clipboard write failed:', err);
      }
    }

    copyButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const text = btn.getAttribute('data-copy-target') || '';
        copyShortcut(text, btn);
      });
    });

    // Also copy when clicking keycap container
    keycapContainers.forEach((container) => {
      container.addEventListener('click', () => {
        const card = container.closest('.shortcut-card');
        if (!card) return;
        const text = card.getAttribute('data-copy-shortcut') || '';
        const btn = card.querySelector<HTMLButtonElement>('.copy-shortcut-btn');
        copyShortcut(text, btn);
      });
    });

    // Initial run on mount to ensure clean state
    applyFilter();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupShortcutMatrix);
  } else {
    setupShortcutMatrix();
  }

  document.addEventListener('astro:after-swap', setupShortcutMatrix);
  document.addEventListener('astro:page-load', setupShortcutMatrix);
</script>

<style>
  .shortcut-matrix-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Controls Bar */
  .matrix-controls-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .category-tabs {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--color-surface, #ffffff);
    padding: 4px;
    border: 1px solid var(--color-border, #e4e4e7);
    border-radius: var(--radius-full, 9999px);
    overflow-x: auto;
  }

  .cat-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-full, 9999px);
    font-family: var(--font-display);
    font-size: var(--font-size-sm, 14px);
    font-weight: 500;
    color: var(--color-text-secondary, #52525b);
    cursor: pointer;
    transition: all var(--transition-fast, 150ms ease);
    white-space: nowrap;
  }

  .cat-tab-btn:hover {
    color: var(--color-text-primary, #09090b);
    background: var(--color-surface-elevated, #f4f4f5);
  }

  .cat-tab-btn.active {
    background: var(--color-surface-elevated, #f4f4f5);
    color: var(--color-text-primary, #09090b);
    font-weight: 600;
    border-color: var(--color-border, #e4e4e7);
    box-shadow: var(--shadow-sm, 0 1px 2px 0 rgba(0, 0, 0, 0.05));
  }

  .tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    font-size: 11px;
    font-weight: 600;
    border-radius: var(--radius-full, 9999px);
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-text-tertiary, #71717a);
  }

  .cat-tab-btn.active .tab-count {
    background: rgba(10, 132, 255, 0.15);
    color: var(--brand-apple-blue-vibrant, #0071e3);
  }

  /* Search Input Wrap */
  .search-input-wrap {
    display: flex;
    align-items: center;
    position: relative;
    min-width: 320px;
    flex: 1;
    max-width: 480px;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    width: 16px;
    height: 16px;
    color: var(--color-text-tertiary);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    height: 40px;
    padding: 0 38px 0 38px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-text-primary);
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .search-input:focus {
    border-color: var(--brand-apple-blue);
    box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.15);
  }

  .search-input::placeholder {
    color: var(--color-text-tertiary);
  }

  .search-clear-btn {
    position: absolute;
    right: 12px;
    background: transparent;
    border: none;
    color: var(--color-text-tertiary);
    cursor: pointer;
    padding: 4px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .search-clear-btn:hover {
    color: var(--color-text-primary);
  }

  /* Shortcuts Grid */
  .shortcuts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  /* Enforce hidden attribute for flex containers */
  .shortcut-card[hidden],
  .empty-state-card[hidden],
  .search-clear-btn[hidden] {
    display: none !important;
  }

  .shortcut-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e4e4e7);
    border-radius: var(--radius-lg, 14px);
    box-shadow: var(--shadow-sm, 0 1px 2px 0 rgba(0, 0, 0, 0.05));
    transition: transform var(--transition-fast, 150ms ease), border-color var(--transition-fast, 150ms ease);
    gap: 16px;
  }

  .shortcut-card:hover {
    transform: translateY(-1px);
    border-color: rgba(10, 132, 255, 0.3);
  }

  .shortcut-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }

  .shortcut-header-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .shortcut-action {
    font-family: var(--font-display);
    font-size: var(--font-size-base, 16px);
    font-weight: 600;
    color: var(--color-text-primary, #09090b);
    margin: 0;
  }

  .shortcut-badge {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    color: var(--brand-apple-blue-vibrant, #0071e3);
    background: rgba(10, 132, 255, 0.1);
    padding: 2px 6px;
    border-radius: var(--radius-sm, 6px);
    border: 1px solid rgba(10, 132, 255, 0.2);
  }

  .shortcut-desc {
    font-family: var(--font-body);
    font-size: var(--font-size-xs, 12px);
    color: var(--color-text-secondary, #52525b);
    margin: 0;
    line-height: 1.4;
  }

  .shortcut-action-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  /* Authentic Keycaps Styling */
  .keycaps-container {
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
  }

  .keycap-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 26px;
    padding: 0 7px;
    background: var(--color-surface-elevated, #f4f4f5);
    border: 1px solid var(--color-border, #e4e4e7);
    border-bottom: 2px solid rgba(0, 0, 0, 0.2);
    border-radius: var(--radius-sm, 6px);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-primary, #09090b);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 1px 2px rgba(0,0,0,0.1);
    user-select: none;
    transition: transform var(--transition-fast, 150ms ease);
  }

  .keycaps-container:active .keycap-pill {
    transform: translateY(1px);
    border-bottom-width: 1px;
  }

  /* Copy Button */
  .copy-shortcut-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: var(--color-surface-elevated, #f4f4f5);
    border: 1px solid var(--color-border, #e4e4e7);
    border-radius: var(--radius-md, 10px);
    font-family: var(--font-display);
    font-size: var(--font-size-xs, 12px);
    font-weight: 500;
    color: var(--color-text-secondary, #52525b);
    cursor: pointer;
    transition: all var(--transition-fast, 150ms ease);
  }

  .copy-shortcut-btn:hover {
    color: var(--color-text-primary);
    border-color: rgba(10, 132, 255, 0.4);
    background: rgba(10, 132, 255, 0.08);
  }

  .copy-shortcut-btn .check-icon {
    display: none;
  }

  .copy-shortcut-btn.copied {
    color: #30d158;
    border-color: rgba(48, 209, 88, 0.4);
    background: rgba(48, 209, 88, 0.1);
  }

  .copy-shortcut-btn.copied .default-icon {
    display: none;
  }

  .copy-shortcut-btn.copied .check-icon {
    display: inline-block;
  }

  /* Expand Action Wrap */
  .expand-action-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 8px;
  }

  .expand-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 20px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-primary);
    transition: all var(--transition-fast);
  }

  .expand-toggle-btn:hover {
    border-color: rgba(10, 132, 255, 0.4);
    background: var(--color-surface-elevated);
    transform: translateY(-1px);
  }

  .expand-chevron {
    transition: transform var(--transition-fast, 150ms ease);
    color: var(--color-text-secondary);
  }

  .expand-toggle-btn.expanded .expand-chevron {
    transform: rotate(180deg);
  }

  /* Empty State */
